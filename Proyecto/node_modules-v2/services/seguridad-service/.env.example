# local usa localhost y los puertos publicados por Docker Compose.
# docker usa los nombres de servicio y sus puertos internos.
INFRASTRUCTURE_MODE=local
PORT_SEGURIDAD=4002

# Para desarrollo local, reemplaza este valor por un secreto propio.
JWT_SECRET=clave-temporal-de-desarrollo

# Opcionales: anulan el perfil seleccionado.
# MONGODB_URI=mongodb://admin:password123@localhost:27018/seguridad?authSource=admin
# RABBITMQ_URL=amqp://guest:guest@localhost:5673
