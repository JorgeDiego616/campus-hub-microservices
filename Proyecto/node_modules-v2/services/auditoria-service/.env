# Configuración del Sistema (La Resistencia del Tártaro)
PORT_GATEWAY=4000
PORT_ULSA=4001
PORT_SEGURIDAD=4002
PORT_AUDITORIA=4003

# MongoDB
MONGODB_URI=mongodb://admin:password123@localhost:27018/resistencia?authSource=admin

# Redis Stack
REDIS_URL=redis://default:password123@localhost:6380

# Neo4j
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ScyllaDB / Cassandra
SCYLLADB_CONTACT_POINTS=127.0.0.1
SCYLLADB_PORT=9043

# RabbitMQ Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5673