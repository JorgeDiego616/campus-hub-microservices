import {
  AsignacionMateria,
  Calificacion,
  Carrera,
  Examen,
  Falta,
  HorasBecarias,
  HorasComplementarias,
  Inscripcion,
  Materia,
  PerfilAcademico,
  Periodo
} from '../domain/entities.js';
import { DIAS_SEMANA, SesionHorario } from '../domain/horario.js';
import {
  assertCanAccessStudent,
  assertCanManageCatalog,
  assertCanRegisterHours,
  assertProfessorOwnsAssignment,
  requireActor,
  Roles
} from '../domain/authorization.js';

// Caché vacía por si no se inyecta ninguna (el sistema funciona igual, sin caché)
const CACHE_VACIA = { get: async () => null, set: async () => {}, del: async () => {} };

export class AcademicUseCases {
  constructor({ repositories, eventPublisher, cache = CACHE_VACIA, horarioTtlSeconds = 86400 }) {
    this.repositories = repositories;
    this.eventPublisher = eventPublisher;
    this.cache = cache;
    this.horarioTtlSeconds = horarioTtlSeconds;
  }

  async publish(event, payload) {
    await this.eventPublisher.publish(event, payload);
  }

  async crearCarrera(actor, input) {
    assertCanManageCatalog(actor);
    const carrera = new Carrera(input);
    const result = await this.repositories.carreras.create(carrera);
    await this.publish('CARRERA_CREADA', { id: result.id, nombre: result.nombre });
    return result;
  }

  listarCarreras() { return this.repositories.carreras.findAll(); }

  async crearMateria(actor, input) {
    assertCanManageCatalog(actor);
    const materia = new Materia(input);
    return this.repositories.materias.create(materia);
  }

  listarMaterias() { return this.repositories.materias.findAll(); }

  async crearPeriodo(actor, input) {
    assertCanManageCatalog(actor);
    const periodo = new Periodo(input);
    return this.repositories.periodos.create(periodo);
  }

  listarPeriodos() { return this.repositories.periodos.findAll(); }

  async crearPerfil(actor, input) {
    assertCanManageCatalog(actor);
    const perfil = new PerfilAcademico(input);
    await this.repositories.carreras.requireById(perfil.carreraId);
    return this.repositories.perfiles.upsertByUser(perfil);
  }

  async perfilAcademico(actor, usuarioId) {
    assertCanAccessStudent(actor, usuarioId);
    return this.repositories.perfiles.findByUser(usuarioId);
  }

  async crearAsignacion(actor, input) {
    assertCanManageCatalog(actor);
    const asignacion = new AsignacionMateria(input);
    await Promise.all([
      this.repositories.materias.requireById(asignacion.materiaId),
      this.repositories.periodos.requireById(asignacion.periodoId)
    ]);
    return this.repositories.asignaciones.create(asignacion);
  }

  async asignaciones(actor, periodoId) {
    requireActor(actor);
    if (actor.rol === Roles.ADMIN) return this.repositories.asignaciones.findAll(periodoId);
    if (actor.rol === Roles.PROFESOR) return this.repositories.asignaciones.findByProfessor(actor.id, periodoId);
    if ([Roles.ESTUDIANTE, Roles.BECARIO].includes(actor.rol)) {
      return this.repositories.asignaciones.findByStudent(actor.id, periodoId);
    }
    throw new Error('No tienes permiso para consultar asignaciones.');
  }

  async inscribir(actor, input) {
    assertCanAccessStudent(actor, input.alumnoId);
    const inscripcion = new Inscripcion(input);
    const asignacion = await this.repositories.asignaciones.requireById(inscripcion.asignacionMateriaId);
    Inscripcion.asegurarNoDuplicada(await this.repositories.inscripciones.exists(inscripcion.alumnoId, inscripcion.asignacionMateriaId));
    const result = await this.repositories.inscripciones.create(inscripcion);
    // El horario del alumno cambió: se borra su caché para que se regenere
    const clave = this.claveHorario(result.alumnoId, asignacion.periodoId);
    console.log(`🗑️ USE CASE CACHE INVALIDATE (inscribir): ${clave}`);
    await this.cache.del([clave]);
    await this.publish('INSCRIPCION_CREADA', { id: result.id, alumnoId: result.alumnoId, asignacionMateriaId: result.asignacionMateriaId });
    return result;
  }

  async inscripciones(actor, alumnoId) {
    requireActor(actor);
    if (actor.rol === Roles.ADMIN) return this.repositories.inscripciones.findByStudent(alumnoId);
    if (actor.rol === Roles.PROFESOR) return this.repositories.inscripciones.findByStudentForProfessor(alumnoId, actor.id);
    assertCanAccessStudent(actor, alumnoId);
    return this.repositories.inscripciones.findByStudent(alumnoId);
  }

  async requireManagedInscripcion(actor, inscripcionId) {
    const inscripcion = await this.repositories.inscripciones.requireById(inscripcionId);
    const asignacion = await this.repositories.asignaciones.requireById(inscripcion.asignacionMateriaId);
    assertProfessorOwnsAssignment(actor, asignacion);
    return { inscripcion, asignacion };
  }

  async registrarCalificacion(actor, input) {
    await this.requireManagedInscripcion(actor, input.inscripcionId);
    const calificacion = new Calificacion(input);
    const result = await this.repositories.calificaciones.create(calificacion);
    await this.publish('CALIFICACION_REGISTRADA', { id: result.id, inscripcionId: result.inscripcionId });
    return result;
  }

  async calificaciones(actor, inscripcionId) {
    const inscripcion = await this.repositories.inscripciones.requireById(inscripcionId);
    if (actor.rol === Roles.PROFESOR || actor.rol === Roles.ADMIN) await this.requireManagedInscripcion(actor, inscripcionId);
    else assertCanAccessStudent(actor, inscripcion.alumnoId);
    return this.repositories.calificaciones.findByInscripcion(inscripcionId);
  }

  async registrarFalta(actor, input) {
    await this.requireManagedInscripcion(actor, input.inscripcionId);
    const falta = new Falta(input);
    const result = await this.repositories.faltas.create(falta);
    await this.publish('FALTA_REGISTRADA', { id: result.id, inscripcionId: result.inscripcionId });
    return result;
  }

  async faltas(actor, inscripcionId) {
    const inscripcion = await this.repositories.inscripciones.requireById(inscripcionId);
    if (actor.rol === Roles.PROFESOR || actor.rol === Roles.ADMIN) await this.requireManagedInscripcion(actor, inscripcionId);
    else assertCanAccessStudent(actor, inscripcion.alumnoId);
    return this.repositories.faltas.findByInscripcion(inscripcionId);
  }

  async registrarExamen(actor, input) {
    const examen = new Examen(input);
    const asignacion = await this.repositories.asignaciones.requireById(examen.asignacionMateriaId);
    assertProfessorOwnsAssignment(actor, asignacion);
    const periodoDocument = await this.repositories.periodos.requireById(examen.periodoId);
    const periodo = new Periodo(periodoDocument);
    examen.validarPeriodo(periodo, asignacion.periodoId);
    const result = await this.repositories.examenes.create(examen);
    await this.publish('EXAMEN_REGISTRADO', { id: result.id, asignacionMateriaId: result.asignacionMateriaId });
    return result;
  }

  async examenes(actor, asignacionMateriaId) {
    const asignacion = await this.repositories.asignaciones.requireById(asignacionMateriaId);
    requireActor(actor);
    if (actor.rol === Roles.PROFESOR || actor.rol === Roles.ADMIN) {
      assertProfessorOwnsAssignment(actor, asignacion);
    } else {
      assertCanAccessStudent(actor, actor.id);
      const estaInscrito = await this.repositories.inscripciones.exists(actor.id, asignacionMateriaId);
      if (!estaInscrito) throw new Error('No tienes una inscripción en esta asignación.');
    }
    return this.repositories.examenes.findByAsignacion(asignacionMateriaId);
  }

  async registrarHorasBecarias(actor, input) {
    assertCanRegisterHours(actor, input.alumnoId);
    await this.repositories.periodos.requireById(input.periodoId);
    return this.repositories.horasBecarias.create(new HorasBecarias(input));
  }

  async registrarHorasComplementarias(actor, input) {
    assertCanRegisterHours(actor, input.alumnoId);
    await this.repositories.periodos.requireById(input.periodoId);
    return this.repositories.horasComplementarias.create(new HorasComplementarias(input));
  }

  // ===========================================================================
  // HORARIOS (con caché en Redis)
  // ===========================================================================

  claveHorario(alumnoId, periodoId) {
    return `horario:estudiante:${alumnoId}:${periodoId}`;
  }

  // Borra la caché de todos los alumnos inscritos en una asignación
  async invalidarHorariosDeAsignacion(asignacion) {
    const alumnoIds = await this.repositories.inscripciones.findAlumnoIdsByAsignacion(asignacion.id);
    const claves = alumnoIds.map((alumnoId) => this.claveHorario(alumnoId, asignacion.periodoId));
    if (claves.length) {
      console.log(`🗑️ USE CASE CACHE INVALIDATE: ${claves.join(', ')}`);
    }
    await this.cache.del(claves);
  }

  // Convierte sesiones en filas legibles (materia, grupo, día, hora, aula)
  async armarFilas(sesiones, asignaciones) {
    const porAsignacion = new Map(asignaciones.map((asignacion) => [asignacion.id, asignacion]));
    const materiaIds = [...new Set(asignaciones.map((asignacion) => asignacion.materiaId))];
    const materias = await this.repositories.materias.findByIds(materiaIds);
    const porMateria = new Map(materias.map((materia) => [materia.id, materia]));

    return sesiones.map((sesion) => {
      const asignacion = porAsignacion.get(sesion.asignacionMateriaId);
      return {
        id: sesion.id,
        asignacionMateriaId: sesion.asignacionMateriaId,
        materia: porMateria.get(asignacion?.materiaId)?.nombre ?? null,
        grupo: asignacion?.grupo ?? null,
        diaSemana: sesion.diaSemana,
        dia: DIAS_SEMANA[sesion.diaSemana],
        horaInicio: sesion.horaInicio,
        horaFin: sesion.horaFin,
        aula: sesion.aula ?? null,
        carreraIds: (sesion.carreraIds ?? []).map(String)
      };
    });
  }

  // Un profesor no puede tener dos sesiones a la vez, ni dos sesiones en la misma aula
  async asegurarSinConflictos(sesion, asignacion, excludeId = null) {
    const delPeriodo = await this.repositories.asignaciones.findAll(asignacion.periodoId);
    const idsDelProfesor = delPeriodo
      .filter((item) => item.profesorId === asignacion.profesorId)
      .map((item) => item.id);
    const base = { diaSemana: sesion.diaSemana, horaInicio: sesion.horaInicio, horaFin: sesion.horaFin, excludeId };

    const choqueProfesor = await this.repositories.horarios.findOverlapping({ ...base, asignacionIds: idsDelProfesor });
    if (choqueProfesor.length) throw new Error('El profesor ya tiene otra sesión en ese día y horario.');

    if (sesion.aula) {
      const choqueAula = await this.repositories.horarios.findOverlapping({
        ...base,
        asignacionIds: delPeriodo.map((item) => item.id),
        aula: sesion.aula
      });
      if (choqueAula.length) throw new Error('El aula ya está ocupada en ese día y horario.');
    }
  }

  async crearSesionHorario(actor, input) {
    assertCanManageCatalog(actor);
    const sesion = new SesionHorario(input);
    const asignacion = await this.repositories.asignaciones.requireById(sesion.asignacionMateriaId);
    await Promise.all(sesion.carreraIds.map((carreraId) => this.repositories.carreras.requireById(carreraId)));
    await this.asegurarSinConflictos(sesion, asignacion);

    const creada = await this.repositories.horarios.create({ ...sesion });
    await this.invalidarHorariosDeAsignacion(asignacion);
    await this.publish('SESION_HORARIO_CREADA', { id: creada.id, asignacionMateriaId: creada.asignacionMateriaId });
    return (await this.armarFilas([creada], [asignacion]))[0];
  }

  async actualizarSesionHorario(actor, id, input) {
    assertCanManageCatalog(actor);
    const existente = await this.repositories.horarios.requireById(id);
    const cambios = Object.fromEntries(Object.entries(input).filter(([, valor]) => valor !== undefined));
    const sesion = new SesionHorario({ ...existente, ...cambios });

    const asignacion = await this.repositories.asignaciones.requireById(sesion.asignacionMateriaId);
    await Promise.all(sesion.carreraIds.map((carreraId) => this.repositories.carreras.requireById(carreraId)));
    await this.asegurarSinConflictos(sesion, asignacion, id);

    const actualizada = await this.repositories.horarios.update(id, { ...sesion });
    if (existente.asignacionMateriaId !== sesion.asignacionMateriaId) {
      const anterior = await this.repositories.asignaciones.requireById(existente.asignacionMateriaId);
      await this.invalidarHorariosDeAsignacion(anterior);
    }
    await this.invalidarHorariosDeAsignacion(asignacion);
    await this.publish('SESION_HORARIO_ACTUALIZADA', { id: actualizada.id, asignacionMateriaId: actualizada.asignacionMateriaId });
    return (await this.armarFilas([actualizada], [asignacion]))[0];
  }

  async eliminarSesionHorario(actor, id) {
    assertCanManageCatalog(actor);
    const eliminada = await this.repositories.horarios.delete(id);
    const asignacion = await this.repositories.asignaciones.requireById(eliminada.asignacionMateriaId);
    await this.invalidarHorariosDeAsignacion(asignacion);
    await this.publish('SESION_HORARIO_ELIMINADA', { id: eliminada.id, asignacionMateriaId: eliminada.asignacionMateriaId });
    return true;
  }

  // Vista del administrador: todas las sesiones de un periodo
  async horarios(actor, periodoId) {
    assertCanManageCatalog(actor);
    const asignaciones = await this.repositories.asignaciones.findAll(periodoId);
    const sesiones = await this.repositories.horarios.findByAsignaciones(asignaciones.map((asignacion) => asignacion.id));
    return this.armarFilas(sesiones, asignaciones);
  }

  // Horario del alumno autenticado (la identidad sale del token, no de un argumento)
  async miHorario(actor, periodoId) {
    requireActor(actor);
    return this.obtenerHorarioAlumno(actor.id, periodoId);
  }

  // Horario de un alumno concreto: el propio alumno o un administrador
  async horarioAlumno(actor, alumnoId, periodoId) {
    assertCanAccessStudent(actor, alumnoId);
    return this.obtenerHorarioAlumno(alumnoId, periodoId);
  }

  // Patrón cache-aside: Redis primero; si no está, MongoDB y se guarda en Redis
  async obtenerHorarioAlumno(alumnoId, periodoId) {
    const clave = this.claveHorario(alumnoId, periodoId);

    const enCache = await this.cache.get(clave);
    if (enCache !== null) {
      console.log(`⚡ USE CASE CACHE HIT: ${clave}`);
      return enCache;
    }

    console.log(`🔍 USE CASE CACHE MISS: ${clave} → consultando MongoDB`);
    const asignaciones = await this.repositories.asignaciones.findByStudent(alumnoId, periodoId);
    const sesiones = await this.repositories.horarios.findByAsignaciones(asignaciones.map((asignacion) => asignacion.id));
    const filas = await this.armarFilas(sesiones, asignaciones);

    await this.cache.set(clave, filas, this.horarioTtlSeconds);
    console.log(`💾 USE CASE CACHE POPULATED: ${clave}`);
    return filas;
  }
}