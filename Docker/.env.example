# Copiar este archivo a Docker/.env (el .env NO se sube a git) y cambiar valores.
# Si no existe Docker/.env, el compose usa los defaults de local (password123, guest).
#
# Recordatorio: estas contraseñas solo se aplican cuando el volumen se crea
# por primera vez. Si las cambio aquí, también tengo que cambiarlas en las
# URIs de los .env de los servicios (MONGODB_URI, REDIS_URL, NEO4J_PASSWORD,
# RABBITMQ_URL), porque los servicios se conectan con esas.

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia-esto

REDIS_PASSWORD=cambia-esto

# El usuario de Neo4j siempre es "neo4j"; solo se cambia la contraseña.
NEO4J_PASSWORD=cambia-esto

# En la nube no usar guest/guest.
RABBITMQ_USER=ulsa
RABBITMQ_PASSWORD=cambia-esto
